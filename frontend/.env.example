BACKEND_API_URL=http://127.0.0.1:8000

# 배포된 서비스의 공개 주소입니다. canonical URL, sitemap, robots, 공유 이미지 주소에 사용됩니다.
SITE_URL=https://example.com

# Google Search Console에서 발급받은 HTML 태그의 content 값입니다. 선택 사항입니다.
GOOGLE_SITE_VERIFICATION=

# Google AdSense에서 발급받은 공개 식별자입니다. 설정하지 않으면 광고를 렌더링하지 않습니다.
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
NEXT_PUBLIC_GOOGLE_ADSENSE_LEFT_RAIL_SLOT_ID=0000000000
